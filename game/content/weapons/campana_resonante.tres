[gd_resource type="Resource" script_class="WeaponData" format=3]

[ext_resource type="Script" path="res://core/data/weapon_data.gd" id="1_data"]
[ext_resource type="Script" path="res://systems/weapons/campana_resonante.gd" id="2_behaviour"]
[ext_resource type="Resource" path="res://content/weapons/campana_del_juicio.tres" id="3_evolution"]

[resource]
script = ExtResource("1_data")
id = &"campana_resonante"
display_name = "Campana Resonante"
description = "Onda expansiva periódica que daña y empuja a tu alrededor."
tags = Array[StringName]([&"fisico", &"area"])
is_signature = false
behaviour = ExtResource("2_behaviour")
evolution_relic = &"vigor"
evolution = ExtResource("3_evolution")
