[gd_resource type="Resource" script_class="WeaponData" format=3]

[ext_resource type="Script" path="res://core/data/weapon_data.gd" id="1_data"]
[ext_resource type="Script" path="res://systems/weapons/esquirlas_umbrias.gd" id="2_behaviour"]
