[resource]
script = ExtResource("1_data")
id = &"esquirlas_umbrias"
display_name = "Esquirlas Umbrías"
description = "Proyectiles de sombra hacia los enemigos más cercanos; perforan a niveles altos."
tags = Array[StringName]([&"sombra", &"proyectil"])
